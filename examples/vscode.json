{
  "inputs": [
    {
      "type": "promptString",
      "id": "htr-key",
      "description": "HowToRomania API key (htr_demo for the demo)",
      "password": true
    }
  ],
  "servers": {
    "howtoromania": {
      "type": "http",
      "url": "https://api.howtoromania.io/mcp",
      "headers": {
        "Authorization": "Bearer ${input:htr-key}"
      }
    }
  }
}
